{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "node16",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "importHelpers": true,
    "outDir": "./dist",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/"
  ],
  "exclude": [
    "**/*.spec.ts",
    "src/test-utils",
    // examples and tooling, which are not part of the published package
    "src/accessories/*_accessory.ts",
    "src/accessories/gstreamer-audioProducer.ts",
    "src/lib/definitions/generate-definitions.ts",
    "src/lib/definitions/generator-configuration.ts"
  ]
}
